{
  "name": "zagorwatchparty-client",
  "version": "0.1.0",
  "private": true,
  "description": "Watch Party MVP frontend (React + Vite + TypeScript)",
  "type": "module",
  "scripts": {
    "sync-shared": "node ../shared/sync.cjs",
    "dev": "npm run sync-shared && vite",
    "build": "npm run sync-shared && tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "npm run sync-shared && tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hls.js": "^1.5.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
